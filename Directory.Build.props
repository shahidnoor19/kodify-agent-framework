<Project>
  <!-- Shared by every project in the course. One user-secrets store holds the Foundry keys for all of them. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>kodify-agent-framework</UserSecretsId>
  </PropertyGroup>
</Project>
